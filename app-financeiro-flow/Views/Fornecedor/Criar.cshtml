@model app_financeiro_flow.Models.Fornecedor.FornecedorViewModel;

@{
    ViewData["Title"] = "Cadastrar Fornecedor";
}

<div class="container mt-4">
    <div class="card shadow-sm col-md-8 mx-auto">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Novo Fornecedor</h4>
        </div>
        <div class="card-body">
            <form asp-action="Criar" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Nome" class="form-label"></label>
                    <input asp-for="Nome" class="form-control" placeholder="Razão social ou nome do fornecedor" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Cnpj" class="form-label"></label>
                    <input asp-for="Cnpj" class="form-control" placeholder="00.000.000/0000-00" maxlength="18" />
                    <span asp-validation-for="Cnpj" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="IdTipoFornecedor" class="form-label">Tipo de Fornecedor</label>
                        <select asp-for="IdTipoFornecedor" asp-items="ViewBag.TiposFornecedor" class="form-select">
                            <option value="">-- Selecione --</option>
                        </select>
                        <span asp-validation-for="IdTipoFornecedor" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="IdAtivo" class="form-label">Estado</label>
                        <select asp-for="IdAtivo" asp-items="ViewBag.StatusAtivo" class="form-select">
                            <option value="">-- Selecione --</option>
                        </select>
                        <span asp-validation-for="IdAtivo" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-success">Salvar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
