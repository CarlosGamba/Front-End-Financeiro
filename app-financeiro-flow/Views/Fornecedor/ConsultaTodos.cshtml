@model IEnumerable<app_financeiro_flow.Models.Fornecedor.FornecedorViewModel>

@{
    ViewData["Title"] = "Lista de Fornecedores";
}

<div class="container mt-4">
    <h2>Fornecedores</h2>     

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Nome</th>
                <th>CNPJ</th>
                <th>Tipo</th>
                <th>Ativo</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Nome</td>
                        <td>@item.Cnpj</td>
                        <td>@item.IdTipoFornecedor</td>
                        <td>@(item.IdTipoFornecedor == 1 ? "Hotel" : "Fornecedor")</td>
                        <td>@(item.IdAtivo == 1 ? "Sim" : "Não")</td>
                        <td>
                            <!-- Adicione os links de Edição/Detalhes se necessário -->
                            @Html.ActionLink("Editar", "Editar", new { id = item.Id }, new { @class = "btn btn-sm btn-warning" })
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center">Nenhum fornecedor encontrado.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
